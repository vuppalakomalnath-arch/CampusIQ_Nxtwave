# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (Replace with your own connection string in .env)
MONGODB_URI=mongodb+srv://vuppalakomalnath_db_user:HugIj4zlLDjT9VFg@cluster0.wd3h7kk.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_key_here

# AI Providers (At least one is required for RAG answer generation)
# Primary: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Fallback: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embeddings
EMBEDDING_PROVIDER=gemini # 'gemini' | 'openrouter' | 'mock'
EMBEDDING_MODEL=text-embedding-004

# Vector Search (MongoDB Atlas Vector Search Index Name)
VECTOR_INDEX_NAME=college_documents_vector_index

# Queue & Cache (Optional - if Redis is not running, CampusiQ runs local in-process queue)
REDIS_URL=redis://127.0.0.1:6379

# Storage Provider
DOCUMENT_STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=20
